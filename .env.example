# Node automatically loads this file when copied to .env.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_PATH=local/desklink.db
# Set to 1 only behind your trusted HTTPS reverse proxy.
TRUST_PROXY=0
# Public GitHub repository used to discover stable Windows agent releases.
# Set to an empty value to use only locally built artifacts.
RELEASE_REPOSITORY=BigDude129/web-remote-desktop
